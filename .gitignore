# ========================================================
# STRIDEX Frontend (.gitignore)
# ========================================================

# Dependencies
node_modules/

# Production build outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# Debug & Error logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment secrets
.env
.env.local
.env.*.local
.env.*
!.env.example

# Deployment cache
.vercel/

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
